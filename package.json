{
  "name": "@atlasrepo/core",
  "version": "0.2.2",
  "description": "Open, local-first contracts and tooling for evidence-backed decisions.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "schemas",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "MAINTAINERS.md",
    "MIGRATING.md",
    "NOTICE",
    "ROADMAP.md",
    "SECURITY.md"
  ],
  "bin": {
    "atlasrepo-core": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build --silent && node --import tsx --test test/*.test.ts tests/*.test.mjs",
    "test:coverage": "npm run build --silent && node --experimental-test-coverage --import tsx --test test/*.test.ts tests/*.test.mjs",
    "benchmark:dify": "npm run build --silent && node --test tests/benchmark-dify*.test.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "schema:smoke": "npm run build --silent && node dist/cli.js schema-smoke",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "bundledDependencies": [
    "ajv",
    "ajv-formats"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
