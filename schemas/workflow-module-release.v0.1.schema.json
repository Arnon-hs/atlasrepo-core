{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasrepo.com/schemas/core/workflow-module-release.v0.1.schema.json",
  "title": "AtlasRepo workflow module release v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "moduleId", "version", "releasedAt", "title", "summary", "applicability", "inputs", "steps", "checks", "materials"],
  "properties": {
    "schemaVersion": {"const": "atlasrepo.core/workflow-module-release/v0.1"},
    "moduleId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "releasedAt": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "applicability": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "required"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"},
          "description": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "instruction", "checkIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
          "title": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1},
          "checkIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "uri", "digest"],
        "properties": {
          "kind": {"enum": ["lesson", "article", "video", "prompt", "skill", "checklist", "template", "source-file", "other"]},
          "title": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "format": "uri-reference"},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
