{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arnon-hs/atlasrepo-core/v0.2.0/schemas/decision-pack.v0.1.schema.json",
  "title": "AtlasRepo decision pack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "createdAt", "status", "answer", "dossier", "route",
    "modules", "citations", "unresolvedGates", "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "atlasrepo.core/decision-pack/v0.1"},
    "id": {"type": "string", "format": "uuid"},
    "createdAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["recommended", "conditional", "abstained"]},
    "answer": {"type": "string", "minLength": 1},
    "dossier": {"$ref": "#/$defs/dossierRef"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "version", "digest", "title"],
        "properties": {
          "moduleId": {"$ref": "#/$defs/moduleId"},
          "version": {"$ref": "#/$defs/version"},
          "digest": {"$ref": "#/$defs/digest"},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "title", "resourceRef", "digest", "accessHint"],
        "properties": {
          "evidenceId": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "resourceRef": {"type": "string", "minLength": 1},
          "publicUri": {"type": "string", "format": "uri"},
          "digest": {"$ref": "#/$defs/digest"},
          "accessHint": {"enum": ["public", "restricted"]}
        }
      }
    },
    "unresolvedGates": {"$ref": "#/$defs/uniqueStrings"},
    "limitations": {"$ref": "#/$defs/uniqueStrings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "moduleId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dossierRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
