{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasrepo.com/schemas/core/result-pack.v0.1.schema.json",
  "title": "AtlasRepo result pack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "executionPackId", "completedAt", "status", "summary", "evidence"],
  "properties": {
    "schemaVersion": {"const": "atlasrepo.core/result-pack/v0.1"},
    "id": {"type": "string", "format": "uuid"},
    "executionPackId": {"type": "string", "format": "uuid"},
    "completedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "partial", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "digest", "uri"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "uri": {"type": "string", "format": "uri-reference"}
        }
      }
    }
  }
}
