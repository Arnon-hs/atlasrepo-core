{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arnon-hs/atlasrepo-core/v0.2.0/schemas/task-dossier.v0.2.schema.json",
  "title": "AtlasRepo task dossier v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "revision", "createdAt", "updatedAt", "title", "context",
    "evidence", "claims", "hypotheses", "checks", "actions"
  ],
  "properties": {
    "schemaVersion": {"const": "atlasrepo.core/task-dossier/v0.2"},
    "id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "constraints"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "required"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "description": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "hypotheses": {
      "type": "array",
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "decision": {"$ref": "#/$defs/decision"},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "outcome": {"$ref": "#/$defs/outcome"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "idRefs": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "nonEmptyIdRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "title", "resourceRef", "digest", "observedAt",
        "producer", "accessHint", "limitations"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["document", "repository-analysis", "user-input", "execution-result", "dataset", "other"]},
        "title": {"type": "string", "minLength": 1},
        "resourceRef": {"type": "string", "minLength": 1},
        "publicUri": {"type": "string", "format": "uri"},
        "digest": {"$ref": "#/$defs/digest"},
        "observedAt": {"type": "string", "format": "date-time"},
        "producer": {"$ref": "#/$defs/producer"},
        "accessHint": {"enum": ["public", "restricted"]},
        "license": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "classification", "evidenceIds", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "classification": {"enum": ["confirmed", "assumption", "recommendation"]},
        "evidenceIds": {"$ref": "#/$defs/idRefs"},
        "limitations": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "supported", "rejected"]},
        "evidenceIds": {"$ref": "#/$defs/idRefs"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "required", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "hypothesisId": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "passed", "failed", "inconclusive"]},
        "required": {"type": "boolean"},
        "evidenceIds": {"$ref": "#/$defs/idRefs"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "rationale", "hypothesisIds", "evidenceIds", "decidedAt",
        "status", "claimIds", "unresolvedGates", "limitations"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "hypothesisIds": {"$ref": "#/$defs/idRefs"},
        "evidenceIds": {"$ref": "#/$defs/nonEmptyIdRefs"},
        "decidedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["recommended", "conditional", "abstained"]},
        "claimIds": {"$ref": "#/$defs/idRefs"},
        "unresolvedGates": {"$ref": "#/$defs/uniqueStrings"},
        "limitations": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "resultEvidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "running", "completed", "failed", "skipped"]},
        "resultEvidenceIds": {"$ref": "#/$defs/idRefs"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "evidenceIds", "recordedAt"],
      "properties": {
        "status": {"enum": ["succeeded", "partial", "failed", "unknown"]},
        "summary": {"type": "string", "minLength": 1},
        "evidenceIds": {"$ref": "#/$defs/idRefs"},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
